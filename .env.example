# Compose uses host networking; these are the actual listener settings.
LISTEN_IP=127.0.0.1
LISTEN_PORT=3011
# Allowed client IPs/CIDRs. Empty denies all except connections to 127.0.0.0/24.
IP_ALLOWLIST=
ACTIVITY_TIMEOUT=90m
USAGE_STALE_AFTER=5m
# Native mode only (Compose always uses its named volume).
DATA_PATH=data/brainiac.db
